#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        ht_1s: ht_1s {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_1S";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2      &ht_1s LG(LS(NUMBER_3)) NUMBER_3  &ht_1s LG(LS(NUMBER_4)) NUMBER_4  &ht_1s LG(LS(NUMBER_5)) NUMBER_5  &mo 1                                                                                        &mo 3                      &kp N6  &kp N7    &kp N8        &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W       &kp E                             &kp R                             &kp T                             &mo 4                                                                                        &tog 4                     &kp Y   &kp U     &kp I         &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S       &kp D                             &kp F                             &kp G                             &kp LS(LA(LC(LEFT_GUI)))  &kp LCTRL  &kp LALT              &kp RIGHT_ALT      &kp RCTRL      &kp RS(RA(RC(RIGHT_GUI)))  &kp H   &kp J     &kp K         &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X       &kp C                             &kp V                             &kp B                                                                  &kp LA(LEFT_GUI)      &kp RA(RIGHT_GUI)                                            &kp N   &kp M     &kp COMMA     &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &caps_word  &kp LEFT                          &kp RIGHT                                                           &kp SPACE                 &kp TAB    &kp LEFT_GUI          &kp RIGHT_GUI      &kp BACKSPACE  &kp RETURN                         &kp DOWN  &kp UP_ARROW  &kp LBKT  &kp RBKT  &kp LC(LG(SPACE))
            >;

            label = "base";
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none  &none  &none  &none  &none  &none  &trans                                          &none      &none  &none      &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &none
&none  &none  &none  &none  &none  &none  &none                                           &none      &none  &kp KP_N7  &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &none
&none  &none  &none  &none  &none  &none  &none   &none  &none      &none  &none          &none      &none  &kp KP_N4  &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &none
&none  &none  &none  &none  &none  &none                 &none      &none                            &none  &kp KP_N1  &kp KP_N2     &kp KP_N3      &none            &none
&none  &none  &none  &none  &none         &none   &none  &none      &none  &kp BACKSPACE  &kp KP_N0         &none      &none         &kp KP_DOT     &none            &none
            >;

            label = "keypad";
        };

        fn {
            display-name = "Fn";
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none                     &none             &none                     &none  &kp LG(F5)
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &kp C_PREVIOUS            &kp C_PLAY_PAUSE  &kp C_NEXT                &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &kp C_VOLUME_DOWN         &kp C_MUTE        &kp C_VOLUME_UP           &none  &none
&none  &none  &none  &none  &none  &none                &none      &none                &none  &kp C_BRIGHTNESS_DEC      &none             &kp C_BRIGHTNESS_INC      &none  &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none         &kp LC(C_BRIGHTNESS_DEC)  &none             &kp LC(C_BRIGHTNESS_INC)  &none  &none
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        nav {
            bindings = <
&none   &none  &none  &none  &none  &none  &none                                     &none   &none     &none     &none   &none      &none  &none
&none   &none  &none  &none  &none  &none  &trans                                    &tog 4  &none     &none     &none   &none      &none  &none
&none   &none  &none  &none  &none  &none  &none   &trans  &trans      &none  &none  &none   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &none
&trans  &none  &none  &none  &none  &none                  &none       &none                 &none     &none     &none   &none      &none  &none
&none   &none  &none  &none  &none         &none   &none   &trans      &none  &none  &none             &none     &none   &none      &none  &none
            >;

            label = "nav";
        };
    };
};
